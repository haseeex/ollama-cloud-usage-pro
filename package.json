{
  "name": "ollama-cloud-usage-pro",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "1.2.0",
  "publisher": "haseeex",
  "author": {
    "name": "vancat",
    "url": "https://github.com/haseeex"
  },
  "contributors": [
    {
      "name": "Nguyễn Hoàng Long (LongNH94)",
      "email": "longnh94@fpt.com",
      "url": "https://github.com/longnh0411"
    }
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/haseeex/ollama-cloud-usage-pro.git"
  },
  "bugs": {
    "url": "https://github.com/haseeex/ollama-cloud-usage-pro/issues"
  },
  "homepage": "https://github.com/haseeex/ollama-cloud-usage-pro#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ollama",
    "ollama-cloud",
    "usage",
    "quota",
    "monitoring"
  ],
  "icon": "resources/ollama-cloud.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ollamaCloud.refresh",
        "title": "%cmd.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "ollamaCloud.addAccount",
        "title": "%cmd.addAccount%",
        "icon": "$(add)"
      },
      {
        "command": "ollamaCloud.removeAccount",
        "title": "%cmd.removeAccount%",
        "icon": "$(trash)"
      },
      {
        "command": "ollamaCloud.openPanel",
        "title": "%cmd.openPanel%",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "ollamaCloud.setRefreshInterval",
        "title": "%cmd.setRefreshInterval%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ollamaCloud.setUsagePrecision",
        "title": "%cmd.setUsagePrecision%",
        "icon": "$(symbol-number)"
      },
      {
        "command": "ollamaCloud.toggleLanguage",
        "title": "%cmd.toggleLanguage%",
        "icon": "$(globe)"
      }
    ],
    "menus": {},
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "ollamaCloud.refreshInterval": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 86400,
          "markdownDescription": "%config.refreshInterval%"
        },
        "ollamaCloud.usagePrecision": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 4,
          "markdownDescription": "%config.usagePrecision%"
        },
        "ollamaCloud.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.zh%",
            "%config.language.en%"
          ],
          "default": "auto",
          "markdownDescription": "%config.language%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/api.test.js out/sharedCache.test.js out/quotaPredictor.test.js out/barAllocation.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.7.2"
  }
}
